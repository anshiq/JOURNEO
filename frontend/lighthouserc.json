{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:4173/c/lighthouse-template"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lhci-reports"
    }
  }
}
